# Base de Datos
DB_PASSWORD=tu_contraseña_de_usuario_mysql
DB_ROOT_PASSWORD=tu_contraseña_root_mysql

# Puerto de la Aplicación
APP_PUERTO=8080

# Sesión (1 = requiere HTTPS, 0 = permite HTTP en desarrollo local)
SESSION_SECURE=0

# Inactividad de la sesión en segundos antes de cerrarla (TUR-008): 900 (15 minutos) por defecto
SESION_INACTIVIDAD_SEGUNDOS=900
